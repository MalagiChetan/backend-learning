<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/styles/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="flex gap-10 items-center justify-center">
        <div
          class="form bg-zinc-900 min-h-screen text-white w-[80%] p-8! border border-white"
        >
          <form class="flex flex-col gap-4" action="/" method="POST">
            <input
              class="p-2! border border-white rounded"
              type="text"
              name="title"
              placeholder="Enter your title"
            />
            <textarea
              rows="8"
              class="p-2! border border-white rounded- resize-none"
              name="description"
              placeholder="Enter your description"
            ></textarea>
            <button type="submit" class="bg-blue-500 p-2! rounded self-center w-30">
              Submit
            </button>
          </form>
          <div class="card">
            <% if(files.length > 0) { %>
            <% files.forEach((val) => { %>
              <h1><%= val %></h1>
              <a href="/read/<%= val %>">Read More</a>
            <% }); %>
            <% } else{ %>
              <h1 class="flex justify-center block mt-4">No tasks available</h1>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <script src="/javascript/script.js"></script>
  </body>
</html>
